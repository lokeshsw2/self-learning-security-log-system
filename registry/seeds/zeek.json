  {
   "body": {
    "class": "network_activity",
    "constants": {
     "activity_id": 6,
     "connection_info.direction_id": 0,
     "metadata.log_name": "conn",
     "metadata.product.name": "Zeek",
     "metadata.product.vendor_name": "Zeek",
     "severity_id": 1
    },
    "fields": [
     {
      "confidence": "high",
      "from": "ts",
      "note": "Zeek ts (epoch seconds or ISO)",
      "to": "time",
      "transform": {
       "fn": "parse_timestamp"
      }
     },
     {
      "confidence": "high",
      "from": "id.orig_h",
      "note": "originator address",
      "to": "src_endpoint.ip"
     },
     {
      "confidence": "high",
      "from": "id.orig_p",
      "note": "originator port",
      "to": "src_endpoint.port"
     },
     {
      "confidence": "high",
      "from": "id.resp_h",
      "note": "responder address",
      "to": "dst_endpoint.ip"
     },
     {
      "confidence": "high",
      "from": "id.resp_p",
      "note": "responder port",
      "to": "dst_endpoint.port"
     },
     {
      "confidence": "high",
      "from": "uid",
      "note": "Zeek connection uid",
      "to": "connection_info.uid"
     },
     {
      "confidence": "high",
      "from": "proto",
      "note": "transport",
      "to": "connection_info.protocol_name"
     },
     {
      "confidence": "high",
      "from": "proto",
      "note": "IANA number for the transport",
      "to": "connection_info.protocol_num",
      "transform": {
       "args": {
        "map": {
         "ah": 51,
         "esp": 50,
         "gre": 47,
         "icmp": 1,
         "icmp6": 58,
         "tcp": 6,
         "udp": 17
        }
       },
       "fn": "enum_lookup"
      }
     },
     {
      "confidence": "medium",
      "from": "history",
      "note": "Zeek connection history string",
      "to": "connection_info.flag_history"
     },
     {
      "confidence": "medium",
      "from": "service",
      "note": "application protocol Zeek identified",
      "to": "app_protocol_name"
     },
     {
      "confidence": "high",
      "from": "duration",
      "note": "seconds to milliseconds",
      "to": "duration",
      "transform": {
       "args": {
        "factor": 1000
       },
       "fn": "scale"
      }
     },
     {
      "confidence": "high",
      "from": "orig_bytes",
      "note": "payload bytes from originator",
      "to": "traffic.bytes_out"
     },
     {
      "confidence": "high",
      "from": "resp_bytes",
      "note": "payload bytes from responder",
      "to": "traffic.bytes_in"
     },
     {
      "confidence": "high",
      "from": "orig_pkts",
      "note": "packets from originator",
      "to": "traffic.packets_out"
     },
     {
      "confidence": "high",
      "from": "resp_pkts",
      "note": "packets from responder",
      "to": "traffic.packets_in"
     }
    ],
    "labels": {
     "event_type": "conn.log",
     "product": "Zeek",
     "vendor": "Zeek"
    },
    "match": {
     "requires": [
      "id.orig_h",
      "id.resp_h",
      "conn_state",
      "proto"
     ]
    },
    "scope": {
     "bucket": "json\\|"
    }
   },
   "meta": {
    "created_by": "seed",
    "license": "Apache-2.0",
    "needs_human_review": true,
    "note": "Zeek conn.log",
