ersion": 1, "status": "active", "body": {"mode": "extend", "patterns": [{"group": 1, "name": "cronuser", "pattern": "\\(([^()\\s]+)\\)", "placeholder": "<USER>"}], "priority": 10, "scope": {"bucket": "^json_wrap>syslog_iso>unstructured\\|crontab$", "stream": "linux"}}, "meta": {"check": "signatures 311 -> 2 on 744 lines", "created_by": "grouping-c", "note": ""}}, {"rule_id": "mask:linux-json-wrap-syslog-iso-unstructured-systemd", "version": 1, "status": "active", "body": {"mode": "extend", "patterns": [{"group": 1, "name": "unit", "pattern": "([A-Za-z0-9_.@\\-]+)\\.service", "placeholder": "<UNIT>"}], "priority": 10, "scope": {"bucket": "^json_wrap>syslog_iso>unstructured\\|systemd$", "stream": "linux"}}, "meta": {"check": "signatures 15 -> 3 on 298 lines", "created_by": "fixer", "note": ""}}, {"rule_id": "mask:loghub-bgl-unstructured", "version": 1, "status": "active", "body": {"mode": "extend", "patterns": [{"name": "node", "pattern": "\\bR\\d\\d-M\\d-[NL][0-9A-Fa-f](?:-U\\d\\d)?-[A-Z](?::J\\d\\d-U\\d\\d)?\\b", "placeholder": "<NODE>"}, {"name": "node_card", "pattern": "\\bR\\d\\d-M\\d(?:-[NL][0-9A-Fa-f])?\\b", "placeholder": "<NODE>"}, {"name": "chip_id", "pattern": "\\b[0-9A-F]{2}(?::[0-9A-F]{2}){5,}\\b", "placeholder": "<CHIPID>"}, {"group": 1, "name": "ecid", "pattern": "(?:ecid|found) ([0-9A-F]{16,})\\b", "placeholder": "<ECID>"}, {"group": 1, "name": "card_serial", "pattern": "mCardSernum\\(([0-9a-f]+)\\)", "placeholder": "<SERIAL>"}, {"group": 1, "name": "status_time", "pattern": "status=\\w ([A-Z][a-z]{2} [A-Z][a-z]{2} \\d\\d \\d\\d:\\d\\d:\\d\\d [A-Z]{3} \\d{4})", "placeholder": "<TS>"}, {"name": "io_host", "pattern": "\\bbglio\\d+\\b", "placeholder": "<HOST>"}, {"group": 1, "name": "load_path", "pattern": "Error loading (\\S+): ", "placeholder": "<PATH>"}, {"group": 1, "name": "program_path", "pattern": "for program (\\S+)", "placeholder": "<PATH>"}, {"group": 1, "name": "chdir_path", "pattern": "chdir\\(([^)]*)\\)", "placeholder": "<PATH>"}, {"group": 1, "name": "map_path", "pattern": "(?:from|map) file (\\S+?)(?:: |$)", "placeholder": "<PATH>"}, {"group": 1, "name": "bare_hex8_run", "pattern": "[:=]([0-9a-f]{8}(?: [0-9a-f]{8})+)\\b", "placeholder": "<HEX>"}, {"group": 1, "name": "bare_hex8_kv", "pattern": "[:=]([0-9a-f]{8})\\b", "placeholder": "<HEX>"}, {"group": 1, "name": "bare_hex8_iar", "pattern": "\\b(?:iar|dear) ([0-9a-f]{8})\\b", "placeholder": "<HEX>"}], "priority": 10, "scope": {"bucket": "^unstructured\\|\\-$", "stream": "loghub_bgl"}}, "meta": {"check": "signatures 1813 -> 137 on 1991 lines", "created_by": "mask-repair", "note": "BGL RAS: mask node/card locations, ido chip ids, ecid, card serial, io host, ciod paths, bare 8-digit hex register values. Remaining templates are distinct event types (register-dump lines)."}}, {"rule_id": "sign:default", "version": 1, "status": "active", "body": {"depth": 1, "discriminators": ["type", "subtype", "event_type", "eventType", "eventName", "EventID", "event_simpleName", "log_type", "log_subtype", "Operation", "@msgid"], "keys": "auto", "priority": 0, "scope": {"bucket": "*"}, "text": true}, "meta": {"created_by": "builtin", "license": "project licence", "note": "Structured records: top-level key set plus common event-type keys", "source": "this project"}}, {"rule_id": "words:protected", "version": 1, "status": "active", "body": {"words": ["accepted", "accept", "allowed", "allow", "permitted", "permit", "granted", "grant", "passed", "pass", "succeeded", "success", "successful", "authenticated", "authorized", "opened", "open", "started", "start", "connected", "connect", "established", "built", "created", "create", "added", "add", "enabled", "enable", "login", "logon", "logged in", "failed", "fail", "failure", "denied", "deny", "blocked", "block", "rejected", "reject", "dropped", "drop", "refused", "refuse", "forbidden", "invalid", "unauthorized", "error", "timeout", "expired", "locked", "closed", "close", "stopped", "stop", "disconnected", "disconnect", "terminated