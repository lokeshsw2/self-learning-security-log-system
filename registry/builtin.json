{
 "format": "logparser-registry/1",
 "rules": [
  {
   "body": {
    "continuation": [
     "^\\s+at [\\w.$<>]+\\(",
     "^Caused by: ",
     "^\\s+\\.\\.\\. \\d+ more",
     "^\\s{2,}File \""
    ],
    "max_record_lines": 500,
    "multiline_json": true,
    "multiline_xml": true,
    "octet_counting": true
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "note": "Java and Python stack traces, pretty-printed JSON and XML, RFC 6587 octet counting",
    "source": "this project"
   },
   "rule_id": "framing:default"
  },
  {
   "body": {
    "delimiter": " ",
    "drop_pattern": "^#[A-Za-z_]+(?:: |\\t| \\\\x)",
    "field_sep": " ",
    "pattern": "^#Fields: (?P<fields>.+)$"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "note": "W3C extended log format header",
    "source": "this project"
   },
   "rule_id": "directive:w3c"
  },
  {
   "body": {
    "delimiter": "\t",
    "drop_pattern": "^#[A-Za-z_]+(?:: |\\t| \\\\x)",
    "field_sep": "\t",
    "pattern": "^#fields\\t(?P<fields>.+)$"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "note": "Zeek TSV header",
    "source": "this project"
   },
   "rule_id": "directive:zeek-tsv"
  },
  {
   "body": {
    "format": "binary",
    "name": "binary",
    "order": 0,
    "test": {
     "kind": "binary",
     "max_nonprintable": 0.1
    },
    "type": "format"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "source": "this project"
   },
   "rule_id": "detect:binary"
  },
  {
   "body": {
    "name": "json_wrap",
    "order": 3,
    "test": {
     "fields": [
      "message",
      "msg",
      "log",
      "raw",
      "_raw",
      "line"
     ],
     "kind": "json_wrap",
     "max_keys": 6
    },
    "type": "envelope"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "source": "this project"
   },
   "rule_id": "detect:json_wrap"
  },
  {
   "body": {
    "format": "json",
    "header_patterns": {
     "prefix": [
      "^(?:\\[[^\\]]{1,40}\\])*\\s*(?:<(?P<pri>\\d{1,3})>)?(?:\\d+: )?(?P<timestamp>(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) {1,2}\\d{1,2}(?: \\d{4})? \\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?|\\d{4}-\\d\\d-\\d\\d[T ]\\d\\d:\\d\\d:\\d\\d(?:[.,]\\d+)?(?:Z|[+-]\\d\\d:?\\d\\d)?)(?: (?P<host>[A-Za-z0-9][A-Za-z0-9._\\-:]*))?(?: (?P<proc>[^\\s\\[:]+)(?:\\[(?P<pid>\\d+)\\])?)?",
      "^<(?P<pri>\\d{1,3})>(?P<version>\\d{1,2}) (?P<timestamp>\\S+) (?P<host>\\S+)",
      "^<(?P<pri>\\d{1,3})>"
     ]
    },
    "name": "embedded_json",
    "order": 4,
    "test": {
     "kind": "regex",
     "pattern": "^(?P<prefix>[^{]{1,300}?)(?P<payload>\\{\\s*\".*\\})\\s*$"
    },
    "type": "format"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "source": "this project"
   },
   "rule_id": "detect:embedded_json"
  },
  {
   "body": {
    "format": "json",
    "name": "json",
    "order": 5,
    "test": {
     "kind": "json"
    },
    "type": "format"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "source": "this project"
   },
   "rule_id": "detect:json"
  },
  {
   "body": {
    "format": "xml",
    "name": "xml",
    "order": 6,
    "test": {
     "kind": "xml"
    },
    "type": "format"
   },
   "meta": {
    "created_by": "builtin",
    "license": "project licence",
    "source": "this project"
   },
   "rule_id": "detect:xml"
  },
